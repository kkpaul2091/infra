# Create a Cloud SQL instance for MySQL
# Cloud SQL instances are created at the region level, not the zone level.

resource "google_sql_database_instance" "mysql" {
  name             = "myschool-tst-mysql"
  database_version = "MYSQL_8_0"
  region           = "australia-southeast2"

  settings {
    tier              = "db-g1-small"
    availability_type = "ZONAL"

    location_preference {
      zone = "australia-southeast2-a"
    }

    backup_configuration {
      enabled = false
    }

    ip_configuration {
      ipv4_enabled = true
    }
  }

  deletion_protection = false
}
# Create a database in the Cloud SQL instance
resource "google_sql_database" "myschool" {
  name     = "MRPSKP"
  instance = google_sql_database_instance.mysql.name
}
# Create a user for the Cloud SQL instance
resource "google_sql_user" "myschool" {
  name     = "admin"
  instance = google_sql_database_instance.mysql.name
  password = var.db_password
}
# Create a secret in Secret Manager to store the database credentials
